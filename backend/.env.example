ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5433/portfolio

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame
ACCESS_TOKEN_EXPIRE_MINUTES=720

